set(DCEngine_VERSION "@DCINFER_PKG_VERSION@")

include(CMakeFindDependencyMacro)

find_dependency(DCinfer CONFIG)

include("${CMAKE_CURRENT_LIST_DIR}/DCEngineTargets.cmake")

check_required_components(DCEngine)
