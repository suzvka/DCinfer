{
  "version": 3,
  "configurePresets": [
    {
      "name": "gcc-debug",
      "displayName": "GCC Linux Debug",
      "description": "Linux GCC + Ninja (Debug)（需 GCC ≥ 11）",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/gcc-debug",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/vcpkg-toolchain.cmake"
      }
    },
    {
      "name": "gcc-release",
      "displayName": "GCC Linux Release",
      "description": "Linux GCC + Ninja (Release)（需 GCC ≥ 11）",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/gcc-release",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/vcpkg-toolchain.cmake"
      }
    },
    {
      "name": "clang-debug",
      "displayName": "Clang Debug",
      "description": "Clang + Ninja (Debug)（跨平台，需 Clang ≥ 14）",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/clang-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/vcpkg-toolchain.cmake"
      }
    },
    {
      "name": "clang-release",
      "displayName": "Clang Release",
      "description": "Clang + Ninja (Release)（跨平台，需 Clang ≥ 14）",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/clang-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/vcpkg-toolchain.cmake"
      }
    },
    {
      "name": "msvc-debug",
      "displayName": "MSVC x64 Debug",
      "description": "Visual Studio MSVC x64 (Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/msvc-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/vcpkg-toolchain.cmake"
      }
    },
    {
      "name": "msvc-release",
      "displayName": "MSVC x64 Release",
      "description": "Visual Studio MSVC x64 (Release)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/msvc-release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/vcpkg-toolchain.cmake"
      }
    },
    {
      "name": "msvc-ort-cpu",
      "displayName": "MSVC x64 ONNX Runtime CPU (Release)",
      "description": "MSVC x64 + ONNX Runtime CPU EP (Release)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/msvc-ort-cpu",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/vcpkg-toolchain.cmake",
        "BUILD_ENGINE_ONNXRUNTIME": "ON",
        "DCINFER_ORT_EP": "CPU"
      }
    },
    {
      "name": "msvc-ort-cuda",
      "displayName": "MSVC x64 ONNX Runtime CUDA (Release)",
      "description": "MSVC x64 + ONNX Runtime CUDA EP (Release)（需本机 CUDA/cuDNN 环境，构建耗时较长）",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/msvc-ort-cuda",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/vcpkg-toolchain.cmake",
        "BUILD_ENGINE_ONNXRUNTIME": "ON",
        "DCINFER_ORT_EP": "CUDA"
      }
    },
    {
      "name": "core-only",
      "displayName": "Core only (library, no engines)",
      "description": "只构建 DCinfer 核心库；不构建 DCIr / 引擎适配器 / DCNet / 测试 / 示例；零 vcpkg 依赖（跨平台，使用默认生成器）",
      "binaryDir": "${sourceDir}/build/core-only",
      "cacheVariables": {
        "DCINFER_BUILD_IR": "OFF",
        "DCINFER_BUILD_ENGINES": "OFF",
        "DCINFER_BUILD_DCNET": "OFF",
        "DCINFER_BUILD_TESTS": "OFF",
        "DCINFER_BUILD_EXAMPLES": "OFF"
      }
    },
    {
      "name": "core-ir",
      "displayName": "Core + DCIr (JSON/.dcg compiler)",
      "description": "构建 DCinfer 核心库 + DCIr 图编译器；不构建引擎适配器 / DCNet / 测试 / 示例（依赖经 vcpkg feature 'ir' 安装）",
      "binaryDir": "${sourceDir}/build/core-ir",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/vcpkg-toolchain.cmake",
        "DCINFER_BUILD_IR": "ON",
        "DCINFER_BUILD_ENGINES": "OFF",
        "DCINFER_BUILD_DCNET": "OFF",
        "DCINFER_BUILD_TESTS": "OFF",
        "DCINFER_BUILD_EXAMPLES": "OFF"
      }
    }
  ]
}
