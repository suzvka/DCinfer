{
  "dependencies": [
    "nlohmann-json",
    "minizip",
    "zlib"
  ],
  "features": {
    "ort-cpu": {
      "description": "ONNX Runtime engine adapter (CPU EP)",
      "dependencies": [
        "onnxruntime"
      ]
    },
    "ort-cuda": {
      "description": "ONNX Runtime engine adapter (CUDA EP)",
      "dependencies": [
        {
