          "features": [
            "cuda"
          ]
        }
      ]
    },
    "ort-tensorrt": {
      "description": "ONNX Runtime engine adapter (TensorRT EP)",
      "dependencies": [
        {
          "name": "onnxruntime",
          "features": [
            "tensorrt"
          ]
        }
      ]
    },
    "ort-openvino": {
      "description": "ONNX Runtime engine adapter (OpenVINO EP)",
      "dependencies": [
        {
          "name": "onnxruntime",
          "features": [
            "openvino"
          ]
        }
      ]
    }
  }
}
