# DCIrConfig.cmake.in - DCIr 图编译器包配置模板
# 由 configure_package_config_file() 生成；提供 DCIr::DCIr 目标。

@PACKAGE_INIT@

set(DCIr_VERSION "@DCINFER_PKG_VERSION@")

include(CMakeFindDependencyMacro)

# 传递依赖（与 vcpkg feature 'ir' 对应）
find_dependency(DCinfer CONFIG)
find_dependency(nlohmann_json CONFIG)
find_dependency(ZLIB)
find_dependency(unofficial-minizip CONFIG)

include("${CMAKE_CURRENT_LIST_DIR}/DCIrTargets.cmake")

check_required_components(DCIr)
