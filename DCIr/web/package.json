{
  "name": "@dcir/graph-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DCIr 推理图可视化编辑器：core（headless 领域层）+ ui（React Flow 壳）；扩展经 CatalogProvider / LayoutStrategy 注入",
  "exports": {
    ".": "./src/ui/index.tsx",
    "./core": "./src/core/index.ts"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@xyflow/react": "^12.12.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
