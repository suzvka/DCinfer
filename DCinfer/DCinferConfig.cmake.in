# DCinferConfig.cmake.in - DCinfer 核心库包配置模板
# 由 configure_package_config_file() 生成；提供 DCinfer::DCinfer 目标。

@PACKAGE_INIT@

set(DCinfer_VERSION "@DCINFER_PKG_VERSION@")

include(CMakeFindDependencyMacro)

# 核心库唯一常规外部依赖。GCC+libatomic 的导出目标携带裸库名 "atomic"，
# 由平台链接器解析，无需 find_dependency。
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/DCinferTargets.cmake")

check_required_components(DCinfer)
